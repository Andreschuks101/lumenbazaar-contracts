STELLAR_NETWORK=testnet
STELLAR_ACCOUNT=lumenbazaar-testnet-deployer

# Optional overrides. If omitted, scripts use STELLAR_ACCOUNT.
LUMENBAZAAR_SOURCE_ACCOUNT=lumenbazaar-testnet-deployer
LUMENBAZAAR_ADMIN=lumenbazaar-testnet-admin
LUMENBAZAAR_TEST_TOKEN_ADMIN=lumenbazaar-testnet-token-admin
LUMENBAZAAR_POLICY_OWNER=lumenbazaar-testnet-policy-owner

# Independent HTTPS RPC used to cross-check ledger freshness; must differ from LUMENBAZAAR_RPC_URL.
LUMENBAZAAR_TRUSTED_RPC_URL=https://soroban-testnet.stellar.org

# JSON object of reviewed lowercase SHA-256 hashes, one per contract, e.g.
# LUMENBAZAAR_EXPECTED_WASM_HASHES={\"upto-session\":\"<64 hex>\",\"test-token\":\"<64 hex>\",\"policy-wallet-example\":\"<64 hex>\"}
LUMENBAZAAR_EXPECTED_WASM_HASHES=

# Optional minimum source balance in XLM (default 10).
# LUMENBAZAAR_MIN_SOURCE_BALANCE_XLM=10

