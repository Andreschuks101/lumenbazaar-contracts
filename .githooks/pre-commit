#!/bin/sh
set -eu

if command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
  PYTHONDONTWRITEBYTECODE=1 python3 scripts/security/scan_malware.py
elif command -v python >/dev/null 2>&1 && python --version >/dev/null 2>&1; then
  PYTHONDONTWRITEBYTECODE=1 python scripts/security/scan_malware.py
else
  echo "malware scan: Python 3 is required" >&2
  exit 1
fi
