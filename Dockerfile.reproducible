FROM node:22.12.0-bookworm

ARG RUST_VERSION=1.93.1
ARG STELLAR_VERSION=28.0.0
ARG STELLAR_SHA256=207544486734fccb4df1afc4a7745478f9f1e21688b2f9506f0ef36f60ce3fdc
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/usr/local/bin:/usr/bin:/bin

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} \
 && rustup target add wasm32v1-none --toolchain ${RUST_VERSION} \
 && curl -fsSL "https://github.com/stellar/stellar-cli/releases/download/v${STELLAR_VERSION}/stellar-cli-${STELLAR_VERSION}-x86_64-unknown-linux-gnu.tar.gz" -o /tmp/stellar.tar.gz \
 && echo "${STELLAR_SHA256}  /tmp/stellar.tar.gz" | sha256sum --check --strict \
 && tar -xzf /tmp/stellar.tar.gz -C /usr/local/bin stellar \
 && rm /tmp/stellar.tar.gz \
 && useradd --create-home --uid 10001 builder

WORKDIR /source
COPY --chown=builder:builder . /source
USER builder
RUN cargo fetch --locked
ENTRYPOINT ["bash", "scripts/container-verify-reproducibility.sh"]
